// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": false,
  "terminal": {
    "font_weight": 400.0,
    "font_size": 18.0,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18,
  "icon_theme": {
    "mode": "dark",
    "light": "Warm Charmed Icons",
    "dark": "Warm Charmed Icons",
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "scrollbar":{
      "show": "never",
    },
    "indent_guides":{
      "show":"never"
    },
  },
  "outline_panel":{
    "default_width": 300,
    "indent_guides": {
      "show":"never"
    }
  },
  "file_finder":{
    "modal_max_width":"xlarge"
  },
  "scrollbar":{
    "show":"never"
  },
  "gutter":{
    "min_line_number_digits": 0,
    "folds": false
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 18,
  "agent_ui_font_family": "JetBrainsMono Nerd Font",
  "agent_buffer_font_size": 18,
  "vim_mode": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  "drag_and_drop_selection":{
    "enabled": false
  },
  "seed_search_query_from_cursor": "never",
  "current_line_highlight": "none",
  "show_whitespaces": "none",
  "tab_size": 4,
  "auto_indent":"syntax_aware",
  "autosave":{
      "after_delay": {
          "milliseconds": 1000
      }
  },
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_file_reopen": false,
  "centered_layout":{
      "right_padding": 0.15,
      "left_padding": 0.15
  }
}
